# Copy this file to .env and fill in the token. .env is git-ignored.
FMS_API_URL=https://asap.homelandgroup.org/api/db
FMS_API_TOKEN=paste-read-only-token-here

# Local port for this dashboard (unique so it doesn't clash with other dashboards)
PORT=4783
# How long fetched data is cached on the server, in seconds
CACHE_SECONDS=60
